  <property name="styleSheet">
   <string notr="true">QWidget#Mainwindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #07121c, stop:0.5 #102f44, stop:1 #0b2233);
    color: #e6f4ff;
    font-family: "Microsoft YaHei";
    font-size: 11pt;
}
QLabel#labelTitle {
    font-size: 22pt;
    font-weight: 600;
    color: #ffffff;
    padding-left: 6px;
}
QFrame#lineAccent {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1294d6, stop:1 #00c6ff);
    max-height: 3px;
    min-height: 3px;
    border-radius: 2px;
}
QTabWidget::pane {
    border: 1px solid rgba(28, 84, 112, 160);
    border-radius: 10px;
    background: rgba(10, 29, 43, 190);
    margin-top: 12px;
}
QTabBar::tab {
    background: rgba(20, 48, 66, 190);
    color: #cfe6ff;
    padding: 10px 28px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
    min-width: 140px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1cc7ff, stop:1 #1279c4);
    color: #ffffff;
}
QTabBar::tab:hover {
    background: rgba(34, 90, 122, 200);
}
QGroupBox {
    border: 1px solid rgba(44, 93, 120, 190);
    border-radius: 10px;
    margin-top: 18px;
    padding: 16px;
    background: rgba(8, 22, 32, 200);
    font-weight: 500;
    color: #bed9f9;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 6px;
}
QLineEdit, QComboBox, QTextEdit, QSpinBox, QDoubleSpinBox, QTimeEdit, QDateTimeEdit {
    background: rgba(5, 17, 25, 200);
    border: 1px solid rgba(58, 119, 150, 190);
    border-radius: 6px;
    padding: 4px 8px;
    color: #e6f4ff;
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 1px solid #3ec6ff;
}
QComboBox QAbstractItemView {
    background: rgba(10, 28, 40, 230);
    color: #e6f4ff;
    selection-background-color: #1279c4;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    background: rgba(46, 95, 120, 200);
    border: none;
    width: 18px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: rgba(46, 95, 120, 200);
    border: none;
    width: 18px;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1cc7ff, stop:1 #0c66a4);
    color: #ffffff;
    border-radius: 20px;
    padding: 8px 26px;
    font-weight: 600;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3bd3ff, stop:1 #1492d4);
}
QPushButton:pressed {
    background: #0b4f82;
}
QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
}
QCheckBox::indicator:unchecked {
    border: 1px solid rgba(65, 122, 150, 200);
    background: rgba(6, 20, 29, 200);
}
QCheckBox::indicator:checked {
    border: 1px solid #44c0ff;
    background: #1a95d6;
}
QTextEdit {
    min-height: 96px;
}
QLabel {
    color: #d7ecff;
}
   </string>
